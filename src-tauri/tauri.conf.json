{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sampa Terminal",
  "version": "0.1.0",
  "identifier": "com.sampa.terminal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sampa Terminal",
        "width": 960,
        "height": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "A graphical terminal with man-page and command preview",
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
